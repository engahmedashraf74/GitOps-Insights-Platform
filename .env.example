# Copy to .env beside docker-compose.yml. Never commit .env.
# Do not paste production credentials, Argo CD tokens, or Stripe secrets.

# ASCII letters, digits, hyphens, and underscores only.
# Do not use @ / ? # % $ spaces, quotes, or non-ASCII characters.
POSTGRES_USER=gitops
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gitops_insights

# The frontend image build argument is set in docker-compose.yml.
# Next.js embeds it during `npm run build`. Changing this line does not change an existing image.
NEXT_PUBLIC_API_URL=https://api.gitops-insights.com

# Public site origin. APP_URL is the verification-link base. FRONTEND_URL is the Stripe return origin.
# These are backend runtime settings. They are not applied until the backend service is recreated.
APP_URL=https://gitops-insights.com
FRONTEND_URL=https://gitops-insights.com

# Required. Use a long random string that is not the example placeholder.
JWT_SECRET=replace-with-a-long-random-string

# Required before an Argo CD token is stored. At least 32 ASCII letters or digits.
# Not hex or base64. Only the first 32 characters are used.
# If this is empty, the backend uses JWT_SECRET so tokens already encrypted with that
# secret can still be read. There is no built-in encryption key.
# Set this to the secret already used for stored tokens before rotating JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY=replacewith32ormorerandomlettersanddigits

# Optional. Blank means mail is skipped and signup cannot be verified by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GitOps Insights <noreply@gitopsinsights.com>

# Leave Argo CD unset. Users connect from the dashboard.
# The AWS server must reach the URL over HTTPS. Private and cluster-local
# addresses are rejected in production. A private cluster needs a future
# outbound connector; it cannot be reached by this direct connection.
# Optional PEM file for a private certificate authority. Validation stays enabled.
# ARGOCD_CA_FILE=/run/secrets/argocd-ca.pem
# ARGOCD_URL=
# ARGOCD_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_PRO=
# STRIPE_WEBHOOK_SECRET=
