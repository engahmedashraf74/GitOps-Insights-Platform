# Copy to .env beside docker-compose.yml. Never commit .env.
# Do not paste production credentials, Argo CD tokens, or Stripe secrets.

# ASCII letters, digits, hyphens, and underscores only.
# Do not use @ / ? # % $ spaces, quotes, or non-ASCII characters.
POSTGRES_USER=gitops
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gitops_insights

# Browser URL of THIS test API. Rebuilt into the frontend image.
# EC2 example, no DNS change: http://203.0.113.10:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Browser URL of THIS test frontend. Verification links use APP_URL.
APP_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000

# Required. Use a long random string that is not the example placeholder.
JWT_SECRET=replace-with-a-long-random-string

# At least 32 ASCII letters or digits. Not hex or base64.
# Only the first 32 characters are used. Do not change it after an integration token is stored.
INTEGRATION_ENCRYPTION_KEY=replacewith32ormorerandomlettersanddigits

# Optional. Blank means mail is skipped and signup cannot be verified by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GitOps Insights <noreply@gitopsinsights.com>

# Leave Argo CD and Stripe unset.
# ARGOCD_URL=
# ARGOCD_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_PRO=
# STRIPE_WEBHOOK_SECRET=
