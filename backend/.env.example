# Copy to .env for local development. Never commit a filled-in copy.
# Runtime values below are process environment variables. Do not put real
# secrets in this file.
#
# Build-time, not read by the API:
#   NEXT_PUBLIC_API_URL must be set while building the frontend
#   (next build / docker build). A production frontend build refuses to call
#   the API if it is missing. Setting it only on the running frontend pod has
#   no effect.

# ---------------------------------------------------------------------------
# Required at API boot
# ---------------------------------------------------------------------------
# JWT_SECRET is required in every environment. The others are required when
# NODE_ENV=production; production also rejects localhost, private-network,
# and non-https FRONTEND_URL/APP_URL.

DATABASE_URL="postgresql://user:password@localhost:5432/gitops_insights?schema=public"

# Signs and verifies session tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 48
# Rotating this invalidates every issued token (all users are signed out).
JWT_SECRET=""

# Encrypts stored Argo CD API tokens at rest. Minimum 32 characters.
# Must be different from JWT_SECRET. Generate with: openssl rand -base64 48
# Rotating this makes existing stored tokens undecryptable; operators must
# reconnect Argo CD from the Integrations page afterwards.
INTEGRATION_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Required in production (NODE_ENV=production)
# ---------------------------------------------------------------------------

# Public origin of the frontend. Used for CORS, email verification links and
# Stripe redirect URLs. Must not be a localhost or private-network address
# when NODE_ENV=production.
FRONTEND_URL="http://localhost:3001"
APP_URL="http://localhost:3001"

NODE_ENV="development"
PORT="3000"

# Number of proxy hops to trust for client IP resolution (rate limiting).
TRUST_PROXY="1"

# ---------------------------------------------------------------------------
# Argo CD
# ---------------------------------------------------------------------------

# Optional environment-level fallback connection, used when no Integration
# record exists. Refused when NODE_ENV=production, because it would import
# one shared Argo CD into every organization. Leave this false in production.
ARGOCD_URL=""
ARGOCD_TOKEN=""
ARGOCD_ENV_FALLBACK="false"

# Argo CD URLs are rejected if they resolve to a private network address while
# NODE_ENV=production. Set this to true when Argo CD is only reachable
# in-cluster (for example https://argocd-server.argocd.svc.cluster.local).
# Loopback, link-local and cloud metadata addresses are always rejected.
ARGOCD_ALLOW_PRIVATE_NETWORK="false"

ARGOCD_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# Email — without these, registration cannot complete
# ---------------------------------------------------------------------------

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="GitOps Insights <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID_PRO=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Swagger is served at /api/docs outside production. Set to true to expose it
# in production as well.
ENABLE_SWAGGER="false"
